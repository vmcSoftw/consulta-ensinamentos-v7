# Pooled connection string do Neon
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/neondb?sslmode=verify-full"

# Senha usada somente para autenticar o administrador.
# Use pelo menos 8 caracteres e NÃO publique esta senha no código.
ADMIN_PASSWORD="ESCOLHA-UMA-SENHA-FORTE"

# Chave independente usada para proteger as sessões administrativas.
# Gere com: npm run gerar:admin-secret
# Use pelo menos 32 caracteres e NÃO reutilize a ADMIN_PASSWORD.
ADMIN_SESSION_SECRET="COLE-AQUI-UMA-CHAVE-ALEATORIA-GRANDE"
